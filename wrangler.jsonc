{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-ap1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c67b72cb-46e0-4d3d-a6f5-9d3e4fac009a","database_name": "nova-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "da9a99c7ff8a483a9a4dcf1dbad9161b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
